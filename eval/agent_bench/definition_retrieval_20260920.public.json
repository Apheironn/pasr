          {
            "criterion": "RegisteredPlugin.stop -> stop_internal(false), stops GC tracking and clears/drops running interface; not Child.kill",
            "source": "crates/nu-plugin-engine/src/persistent.rs:228-251,276-278"
          },
          {
            "criterion": "Last PluginInterface drop sends/flushed Goodbye, plugin call channel closes and serve loop ends gracefully; child.wait reaps rather than kills",
            "source": "crates/nu-plugin-engine/src/interface/mod.rs:660-668,1219-1232; crates/nu-plugin/src/plugin/interface/mod.rs:339-343; crates/nu-plugin/src/plugin/mod.rs:575-650; crates/nu-plugin-engine/src/init.rs:107-139"
